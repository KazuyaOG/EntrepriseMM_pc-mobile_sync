{
  "name": "gestion-mm-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Synchronisation PC ↔ mobile pour Gestion MM (moteur de fusion, protocole et serveur local).",
  "type": "module",
  "main": "server/server.js",
  "bin": {
