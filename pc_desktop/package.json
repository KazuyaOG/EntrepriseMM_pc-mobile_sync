{
  "name": "gestion-mm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop": "electron .",
    "sync": "node ../shared/server/cli.js --app dist",
    "sync:test": "node --test \"../shared/test/*.test.js\"",
    "test:ui": "node test/run-all.mjs",
    "windows": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "jspdf": "^2.5.2"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ca.entretienmm.gestion",
    "productName": "Gestion MM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
